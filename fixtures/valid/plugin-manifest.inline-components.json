{
  "name": "inline-components",
  "displayName": "CDF Data Checks",
  "version": "1.2.0",
  "description": "Every inline hook and MCP server form the contract admits.",
  "author": {
    "name": "Cognitive Delivery",
    "email": "contact@example.com",
    "url": "https://example.com"
  },
  "homepage": "https://example.com/plugins/cdf-data-checks",
  "repository": "https://example.com/plugins/cdf-data-checks.git",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "cdf",
    "data",
    "quality"
  ],
  "category": "Productivity",
  "metadata": {
    "supportChannel": "https://example.com/support"
  },
  "defaultEnabled": false,
  "skills": "./skills/",
  "commands": [
    "./commands/",
    "./extra-commands/"
  ],
  "agents": "./agents/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard.sh",
            "timeout": 30,
            "once": true
          },
          {
            "type": "prompt",
            "prompt": "Is this command safe to run?",
            "continueOnBlock": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Review the written file for secrets.",
            "model": "claude-sonnet-5-5"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://hooks.example/session",
            "headers": {
              "Authorization": "Bearer $HOOK_TOKEN",
              "X-Source": "cdf"
            },
            "allowedEnvVars": [
              "HOOK_TOKEN"
            ]
          },
          {
            "type": "mcp_tool",
            "server": "deploy-api",
            "tool": "announce",
            "input": {
              "cwd": "${cwd}"
            }
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo switched",
            "args": []
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "deploy-api": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.js"
      ],
      "env": {
        "DEPLOY_TOKEN": "${DEPLOY_TOKEN}",
        "LOG_LEVEL": "info"
      }
    },
    "remote-docs": {
      "type": "http",
      "url": "https://mcp.example/docs",
      "headers": {
        "Authorization": "Bearer ${DOCS_TOKEN}"
      },
      "headersHelper": "./scripts/docs-auth.sh",
      "timeout": 600000,
      "alwaysLoad": false
    },
    "legacy": {
      "command": "python3",
      "args": [
        "-m",
        "legacy_server"
      ]
    }
  },
  "lspServers": {
    "example-lsp": {
      "command": "example-lsp",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".example": "example"
      }
    }
  },
  "cdf": {
    "schemaVersion": "1.0",
    "contributes": {
      "providers": [
        {
          "id": "example-inference",
          "kind": "openai-compatible",
          "baseUrl": "https://api.example.com/v1",
          "model": "example-medium",
          "prices": {
            "input_per_million": 0.5,
            "output_per_million": 1.5
          },
          "extraHosts": [
            "cdn.example.com"
          ]
        }
      ],
      "trackers": [
        {
          "id": "examplecorp",
          "label": "ExampleCorp Work Items",
          "readAction": "examplecorp.readItemStatus",
          "commentAction": "examplecorp.commentCdfStatus",
          "transitionAction": "examplecorp.transitionItem",
          "createAction": "examplecorp.createItemForSpec",
          "externalIdLabel": "item id",
          "externalIdPlaceholder": "e.g. 1234"
        }
      ],
      "docPacks": [
        "./docs/data-quality-pack.json"
      ],
      "checks": [
        {
          "id": "null-rate",
          "worker": "./workers/null-rate.mjs"
        }
      ]
    },
    "capabilities": {
      "tools": [
        "cdf_lint_artefacts"
      ],
      "read_paths": [
        "models/**",
        ".cdf/specs/**"
      ],
      "write_paths": [
        ".cdf/checks/**"
      ],
      "hosts": [
        "api.example.com"
      ],
      "commands": [
        "node"
      ]
    },
    "attestation": {
      "issuer": "plugin",
      "signature": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
      "key_fingerprint": "ab12cd34ef56"
    }
  }
}
