{
  "schema_version": "1.0",
  "agent": {
    "name": "tool args",
    "kind": "delegated-cli",
    "runtime_agent": "claude-code"
  },
  "intent": {
    "purpose": "Declare argument constraints for two tools."
  },
  "allow": {
    "tools": [
      "cdf_begin_work",
      "server/tool",
      "mcp:server:tool",
      "Tool.Name-1"
    ],
    "read_paths": [
      "src/**"
    ],
    "write_paths": [
      "src/**"
    ],
    "hosts": [
      "127.0.0.1",
      "localhost",
      "*.example.com",
      "*",
      "example.com",
      "api-v2.internal.example",
      "xn--bcher-kva.example"
    ],
    "commands": [
      "git",
      "npm",
      "python3.12",
      "my-tool_v2",
      "g++"
    ],
    "tool_args": {
      "cdf_write_artefact": {
        "type": "object",
        "properties": {
          "artefact": {
            "enum": [
              "requirements"
            ]
          }
        }
      },
      "server/tool": {
        "type": "object",
        "additionalProperties": false
      }
    }
  },
  "deny": {
    "commands": [
      "sudo",
      "su"
    ],
    "paths": [],
    "hosts": [
      "evil.example",
      "*.tracker.example"
    ]
  },
  "budget": {},
  "approvals": [
    "phase.advance",
    "external.write"
  ]
}
